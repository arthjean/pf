# Inputs for windows-vt-input-probe.exe through conpty-driver.exe. Each input
# is sent as the VT sequence a terminal emits, and the probe reports what
# ReadConsoleW returns for it. Labels are passed to the probe in this order.
wait "ready" 10000
send "\u001b[A"
wait "got 0"
send "\u001b[1;2A"
wait "got 1"
send "\u001b[1;3A"
wait "got 2"
send "\u001b[1;5A"
wait "got 3"
send "\u001b[1;2D"
wait "got 4"
send "\u001b[1;5D"
wait "got 5"
send "\u001b[1;3C"
wait "got 6"
send "\u001b[1;5C"
wait "got 7"
send "\u001b[B"
wait "got 8"
send "\u001b[H"
wait "got 9"
send "\u001b[F"
wait "got 10"
send "\u001b[3~"
wait "got 11"
send "\r"
wait "got 12"
send "\u007f"
wait "got 13"
send "\t"
wait "got 14"
send "\u001b[Z"
wait "got 15"
send "\u001b"
wait "got 16"
send "\u001b[200~line one\r\nline two\u001b[201~"
wait "got 17"
send "héllo ✓ 日本 𝒑"
wait "got 18"
send "\u0003"
wait "got 19"
send "\u001bb"
wait "got 20"
send "\u001b[I"
wait "got 21"
send "\u001b[97;5u"
wait "got 22"
